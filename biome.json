{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!seed", "!**/dist", "!**/.next", "!**/next-env.d.ts", "!e2e/__snapshots__", "!**/*.md"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always"
    }
  },
  "css": {
    "parser": {
      "cssModules": false
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "a11y": {
        "noSvgWithoutTitle": "error"
      },
      "complexity": {
        "noEmptyTypeParameters": "error",
        "noThisInStatic": "error",
        "noUselessStringRaw": "error",
        "useSimpleNumberKeys": "error"
      },
      "correctness": {
        "noStringCaseMismatch": "error"
      },
      "suspicious": {
        "noSuspiciousSemicolonInJsx": "error"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.css"],
      "linter": {
        "rules": {
          "preset": "recommended"
        }
      }
    }
  ]
}
