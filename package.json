{
  "name": "agar-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.5-canary.20261121.1",
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*"
    ],
    "catalog": {
      "@ui-sdk/core": "0.1.0-beta.14",
      "@ui-sdk/react": "0.1.0-beta.14"
    }
  },
  "scripts": {
    "build": "bun --filter './packages/*' build",
    "dev": "bun --filter './packages/*' --filter docs dev",
    "docs:build": "bun --filter docs build",
    "lint": "bun lint --no-script --type-aware && biome lint .",
    "lint:fix": "bun lint --no-script --type-aware --fix && biome lint --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "size": "size-limit",
    "check:pkg": "bun --filter './packages/*' check:pkg",
    "verify": "bun run fmt:check && bun run lint && bun run build && bun check && bun run test && bun run size && bun run check:pkg",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "bun run build && bun scripts/publish.ts && changeset tag",
    "fmt:check": "bun fmt --no-script --check",
    "check": "bun check --no-script && bun --filter '*' check"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.8",
    "@changesets/cli": "3.0.3",
    "@playwright/test": "1.65.1",
    "@size-limit/preset-small-lib": "14.3.0",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/bun": "1.4.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "publint": "0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "size-limit": "14.3.0",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "esbuild",
    "sharp"
  ]
}
