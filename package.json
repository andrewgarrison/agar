{
  "name": "agar-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" build",
    "dev": "pnpm --parallel --filter \"./packages/*\" --filter docs dev",
    "docs:build": "pnpm --filter docs build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "size": "size-limit",
    "check:pkg": "pnpm --filter \"./packages/*\" check:pkg",
    "verify": "pnpm lint && pnpm build && pnpm typecheck && pnpm test && pnpm size && pnpm check:pkg",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.8",
    "@changesets/cli": "3.0.3",
    "@playwright/test": "1.65.1",
    "@size-limit/preset-small-lib": "14.3.0",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "publint": "0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "size-limit": "14.3.0",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
