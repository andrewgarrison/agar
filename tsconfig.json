{
  // Tooling only: root configs, e2e specs and package build configs. Each
  // package and app has its own tsconfig for its source.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "isolatedDeclarations": false,
    "declaration": false,
    "types": ["node", "bun-types", "bun-types/vitest"]
  },
  "include": ["*.config.ts", "test.setup.ts", "e2e", "scripts", "packages/*/tsdown.config.ts"]
}
